# Copia este archivo como ".env" y llena los valores con los datos de tu
# proyecto de Firebase (Configuración del proyecto > Tus apps > SDK setup).
# Ver README.md sección "Configurar Firebase" para el paso a paso.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
